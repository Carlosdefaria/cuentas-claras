# Plantillas de variables. NUNCA subas los ficheros reales (.env.local, .env.test.local).
#
# .env.local      → rama production (lo rellena `neon deploy` / `neon env pull`)
# .env.test.local → rama test (`neon env pull --branch test --file .env.test.local -s postgres`)
#                   Los tests de BD/RLS usan SOLO este fichero.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=

# Frontend (se añadirán al activar Neon Auth y la Data API)
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
