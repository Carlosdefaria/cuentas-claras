# Plantillas de variables. NUNCA subas los ficheros reales (.env.local, .env.test.local, .env.development.local).
#
# .env.local             → rama production (lo rellena `neon deploy` / `neon env pull`)
# .env.test.local        → rama test (`neon env pull --branch test --file .env.test.local -s postgres,auth,data-api`)
#                          Los tests de BD/RLS usan SOLO este fichero.
# .env.development.local → desarrollo local (`npm run dev`) contra la rama test.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=

# Proxy de Auth (/api/auth/*). SOLO SERVIDOR: nunca con prefijo VITE_.
# En Vercel: por entorno (Preview → rama test; Production → production).
NEON_AUTH_BASE_URL=
# SECRETO (≥ 32 caracteres): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Frontend (público: llega al navegador).
VITE_NEON_DATA_API_URL=
