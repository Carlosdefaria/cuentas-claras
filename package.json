{
  "name": "cuentas-claras",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA scripts/migrate.ts",
    "test:db": "NODE_USE_ENV_PROXY=1 vitest run --config vitest.db.config.ts",
    "db:perf": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA scripts/seedPerf.ts",
    "test:e2e": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA NO_PROXY=localhost,127.0.0.1 playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "libpg-query": "^18.2.4",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
